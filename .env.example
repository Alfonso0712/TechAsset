# =============================================================================
# TechAsset · Plantilla de Variables de Entorno
# Copie este archivo a .env y configure sus credenciales locales:
#   cp .env.example .env
# El archivo .env está excluido en .gitignore y NUNCA debe comitearse.
# =============================================================================

# Base de datos PostgreSQL (administración e inicialización)
POSTGRES_DB=techasset_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<CONTRASENA_POSTGRES_AQUI>

# Rol de aplicación de mínimo privilegio (utilizado por TechAsset.Api en ejecución)
DB_APP_USER=techasset_app
DB_APP_PASSWORD=<CONTRASENA_APP_AQUI>

# Configuración Frontend (Vite)
VITE_USAR_MOCK=false
VITE_API_URL=http://localhost:5000
