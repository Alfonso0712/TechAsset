root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.cs]
indent_size = 4
csharp_new_line_before_open_brace = all
csharp_space_after_cast = false
csharp_space_around_binary_operators = before_and_after

[*.{md,json,yml,yaml}]
indent_size = 2

[*.sql]
indent_size = 2
